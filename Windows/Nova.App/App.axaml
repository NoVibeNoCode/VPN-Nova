<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Nova.App.App"
             RequestedThemeVariant="Dark">
  <!-- Control styling only; views are built in code (see Ui.cs). -->
  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBox.nova">
      <Setter Property="FontFamily" Value="fonts:Nova#Manrope" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#EEF0FF" />
      <Setter Property="CaretBrush" Value="#EEF0FF" />
      <Setter Property="SelectionBrush" Value="#6A5AF0" />
      <Setter Property="Background" Value="#0DFFFFFF" />
      <Setter Property="BorderBrush" Value="#1AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.nova:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
    </Style>
    <Style Selector="TextBox.nova:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderBrush" Value="#8B7CFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.nova:pointerover, TextBox.nova:focus">
      <Setter Property="Foreground" Value="#EEF0FF" />
    </Style>
    <Style Selector="TextBox.nova /template/ TextBlock#PART_Watermark">
      <Setter Property="Foreground" Value="#6B7092" />
    </Style>
    <Style Selector="TextBox.code">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Background" Value="#4D000000" />
    </Style>
    <Style Selector="TextBox.code:pointerover /template/ Border#PART_BorderElement, TextBox.code:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#59000000" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#161A2E" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontFamily" Value="fonts:Nova#Manrope" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#161A2E" />
      <Setter Property="Foreground" Value="#EEF0FF" />
      <Setter Property="FontFamily" Value="fonts:Nova#Manrope" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#EEF0FF" />
      <Setter Property="FontFamily" Value="fonts:Nova#Manrope" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="#6A5AF0" />
    </Style>
  </Application.Styles>
</Application>
